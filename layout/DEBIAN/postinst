#!/bin/sh
# 同时兼容 Dopamine (Rootless /var/jb) 与 Relaxin (RootHide .jbroot-* / procursus)
for helper in /usr/bin/AngelCameraHelper /var/jb/usr/bin/AngelCameraHelper /var/containers/Bundle/Application/.jbroot-*/usr/bin/AngelCameraHelper /private/preboot/*/jb-*/procursus/usr/bin/AngelCameraHelper; do
    if [ -f "$helper" ]; then
        chown root:wheel "$helper" 2>/dev/null || true
        chmod 6755 "$helper" 2>/dev/null || true
    fi
done

# 为 Relaxin (RootHide) 初始化跨进程共享配置目录与动态 Filter Plist 权限
for jbdir in /var/containers/Bundle/Application/.jbroot-* /private/preboot/*/jb-*/procursus; do
    if [ -d "$jbdir" ]; then
        mkdir -p "$jbdir/var/mobile/Library/Preferences" 2>/dev/null || true
        chmod 0777 "$jbdir/var/mobile/Library/Preferences" 2>/dev/null || true
        if [ -f "$jbdir/Library/MobileSubstrate/DynamicLibraries/GeminiSiriOverlay.plist" ]; then
            chmod 0666 "$jbdir/Library/MobileSubstrate/DynamicLibraries/GeminiSiriOverlay.plist" 2>/dev/null || true
        fi
    fi
done
exit 0
